# Required in production.  Use a strong, random value and do not commit .env.
SECRET_KEY=change-me
DATABASE_URL=mysql+pymysql://user:password@db.example.org/library
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REFRESH_TOKEN=

# Comma-separated exact browser origins; leave empty when no browser client is used.
CORS_ALLOWED_ORIGINS=https://app.example.org
MAX_UPLOAD_BYTES=5242880
REQUIRE_HTTPS=1
# Set this only when a trusted reverse proxy terminates TLS and forwards
# the original scheme in X-Forwarded-Proto.
TRUST_PROXY_HEADERS=0
ENABLE_HSTS=1
# Keep API documentation disabled outside controlled development environments.
ENABLE_SWAGGER_UI=0
